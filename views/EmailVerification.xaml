<Page x:Class="MoreConnector.Views.EmailVerification"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" Title="E-mail verificatie">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Rectangle Grid.Row="0" Fill="#FF8C00"/>
        <Rectangle Grid.Row="1" Fill="White"/>

        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="White" CornerRadius="16" Padding="40"
                Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <Button Content="← Terug naar inloggen"
                        Background="Transparent" Foreground="#FF8C00"
                        BorderThickness="0" FontSize="13"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Margin="0,0,0,16" Click="BtnTerug_Click"/>

                <TextBlock Text="✉  Bevestig je e-mailadres"
                           FontSize="24" FontWeight="Bold" Foreground="#111"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="InfoTekst"
                           Text="" FontSize="13" Foreground="#555"
                           TextWrapping="Wrap" Margin="0,0,0,24"/>

                <TextBlock Text="Verificatiecode (6 cijfers)"
                           FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                <Border BorderBrush="#4A90D9" BorderThickness="1.5" CornerRadius="6" Margin="0,0,0,20">
                    <TextBox x:Name="TxtCode" BorderThickness="0" Padding="10,10"
                             FontSize="22" TextAlignment="Center"
                             Background="Transparent" MaxLength="6"/>
                </Border>

                <Button Content="Bevestigen"
                        Background="#FF8C00" Foreground="White"
                        FontSize="14" FontWeight="Bold" Height="46"
                        Cursor="Hand" BorderThickness="0"
                        Margin="0,0,0,12" Click="BtnBevestig_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnOpnieuw" Content="Code opnieuw sturen"
                        Background="Transparent" Foreground="#FF8C00"
                        BorderThickness="0" FontSize="13"
                        HorizontalAlignment="Center" Cursor="Hand"
                        Click="BtnOpnieuw_Click"/>

                <TextBlock x:Name="FoutTekst" Foreground="Red" FontSize="12"
                           Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
