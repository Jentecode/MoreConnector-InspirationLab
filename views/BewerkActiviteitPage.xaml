<Page x:Class="MoreConnector.Views.BewerkActiviteitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Activiteit bewerken">

    <Page.Resources>
        <SolidColorBrush x:Key="OrangeBrush" Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush" Color="#1B2A3B"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E2E40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource NavyBrush}">
        <Border Background="#1E2E40" CornerRadius="12" Padding="32"
                Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Activiteit bewerken" Foreground="White"
                           FontSize="22" FontWeight="Bold" Margin="0,0,0,24"/>

                <TextBlock Text="Naam" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="NaamInput" Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                <TextBlock Text="Locatie" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="LocatieInput" Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                <TextBlock Text="Datum" Style="{StaticResource LabelStyle}"/>
                <DatePicker x:Name="DatumPicker" Margin="0,0,0,8" FontSize="13"/>

                <TextBlock Text="Tijdstip (HH:mm)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TijdInput" Style="{StaticResource InputStyle}" Margin="0,0,0,14" Text="12:00"/>

                <TextBlock Text="Max. deelnemers (0 = onbeperkt)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="MaxDeelnemersInput" Style="{StaticResource InputStyle}" Margin="0,0,0,14" Text="0"/>

                <TextBlock Text="Beschrijving" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="BeschrijvingInput" Style="{StaticResource InputStyle}"
                         Margin="0,0,0,24" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuleren" Background="#555" Foreground="White"
                            BorderThickness="0" Padding="16,10" FontSize="13" Cursor="Hand"
                            Margin="0,0,12,0" Click="OnAnnulerenClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Opslaan" Background="{StaticResource OrangeBrush}" Foreground="White"
                            BorderThickness="0" Padding="16,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                            Click="OnOpslaanClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
