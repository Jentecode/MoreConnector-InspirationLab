<Page x:Class="MoreConnector.Views.EvenementDetail"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Evenement detail">

    <Page.Resources>
        <SolidColorBrush x:Key="OrangeBrush"    Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush"      Color="#1B2A3B"/>
        <SolidColorBrush x:Key="CardBrush"      Color="#1E2E40"/>
        <SolidColorBrush x:Key="WhiteBrush"     Color="White"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="Gray"/>

        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontSize"                   Value="14"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="14,10"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Margin"                     Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC5200"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#993D00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid x:Name="SidebarGrid" Grid.Column="0" Background="#FF8C00">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <TextBlock Grid.Row="0"
                       Text="More&#10;Connector"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       TextAlignment="Center" Margin="12,20,12,12" LineHeight="20"/>

            <!-- Nav knoppen -->
            <StackPanel Grid.Row="1" Margin="6,0,6,0">
                <Button x:Name="BtnHome"         Content="🏠  Home"         Style="{StaticResource SideNavBtn}" Click="SideNav_Home"/>
                <Button x:Name="BtnActiviteiten" Content="🎉  Activiteiten" Style="{StaticResource SideNavBtn}" Click="SideNav_Activiteiten"/>
                <Button x:Name="BtnBerichten"    Content="💬  Berichten"    Style="{StaticResource SideNavBtn}" Click="SideNav_Berichten"/>
                <Button x:Name="BtnGebruikers"   Content="👥  Gebruikers"   Style="{StaticResource SideNavBtn}" Click="SideNav_Gebruikers"/>
                <Button x:Name="BtnNotificaties" Content="🔔  Notificaties" Style="{StaticResource SideNavBtn}" Click="SideNav_Notificaties"/>
                <Button x:Name="BtnAanmaken"     Content="✏️  Aanmaken"     Style="{StaticResource SideNavBtn}" Click="SideNav_Aanmaken"/>
                <Button x:Name="BtnAdmin"        Content="🛡️  Beheer"       Style="{StaticResource SideNavBtn}" Click="SideNav_Admin"
                        Visibility="Collapsed"/>
            </StackPanel>

            <!-- Profiel + uitloggen -->
            <StackPanel Grid.Row="2" Margin="6,0,6,12">
                <Button x:Name="BtnProfiel" Style="{StaticResource SideNavBtn}" Click="SideNav_Profiel" Padding="8,8">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="32" Height="32" Margin="0,0,8,0">
                            <Ellipse x:Name="SideAvatarBg" Width="32" Height="32" Fill="#AAAAAA"/>
                            <Image x:Name="SideAvatarImg" Width="32" Height="32" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/></Image.Clip>
                            </Image>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SideNaamLabel" Text="Profiel"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SideRolLabel" Text=""
                                       Foreground="#FFDDBB" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnUitloggen" Content="🚪  Uitloggen"
                        Style="{StaticResource SideNavBtn}" Click="SideNav_Uitloggen"
                        Foreground="#FFDDBB"/>
            </StackPanel>
        </Grid>

        <!-- MAIN -->
        <ScrollViewer Grid.Column="1" Background="{StaticResource NavyBrush}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="48,32,48,48">
            <StackPanel>

                <!-- Terug -->
                <Button Content="← Terug naar activiteiten"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource OrangeBrush}"
                        FontSize="14" Cursor="Hand" HorizontalAlignment="Left"
                        Margin="0,0,0,24" Click="OnTerugClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Hero afbeelding — hoge resolutie via RenderOptions -->
                <Border x:Name="AfbeeldingBorder"
                        CornerRadius="16" Background="#1E2E40"
                        Height="360" Margin="0,0,0,32"
                        ClipToBounds="True">
                    <Image x:Name="EvenementAfbeelding"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"/>
                </Border>

                <!-- Naam -->
                <TextBlock x:Name="NaamTekst"
                           Foreground="{StaticResource WhiteBrush}"
                           FontSize="30" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Meta kaart -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24,20" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📅  Datum &amp; Tijd" Foreground="{StaticResource OrangeBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DatumTekst" Foreground="{StaticResource WhiteBrush}" FontSize="15" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0">
                            <TextBlock Text="📍  Locatie" Foreground="{StaticResource OrangeBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LocatieTekst" Foreground="{StaticResource WhiteBrush}" FontSize="15" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="👤  Organisator" Foreground="{StaticResource OrangeBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="AuteurTekst" Foreground="{StaticResource WhiteBrush}" FontSize="15" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Beschrijving -->
                <TextBlock Text="Over dit evenement"
                           Foreground="{StaticResource WhiteBrush}"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock x:Name="BeschrijvingTekst"
                           Foreground="#CCCCCC" FontSize="15"
                           TextWrapping="Wrap" LineHeight="24"
                           Margin="0,0,0,32"/>

                <!-- Inschrijven + teller -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,32">
                    <Button x:Name="InschrijvenButton"
                            Content="Inschrijven"
                            Background="{StaticResource OrangeBrush}"
                            Foreground="{StaticResource WhiteBrush}"
                            FontSize="15" FontWeight="SemiBold"
                            BorderThickness="0" Padding="32,12"
                            Cursor="Hand" Margin="0,0,16,0"
                            Click="OnInschrijvenClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CC5200"/></Trigger>
                                    <Trigger Property="IsEnabled"   Value="False"><Setter Property="Background" Value="#555"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="MaxDeelnemersLabel"
                               Foreground="#FFDDBB" FontSize="12"
                               Margin="0,0,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="DeelnemersTeller"
                               Foreground="#AAAAAA" FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Deelnemers sectie -->
                <TextBlock Text="Deelnemers"
                           Foreground="{StaticResource WhiteBrush}"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <WrapPanel x:Name="DeelnemersPanel"/>
                        <TextBlock x:Name="GeenDeelnemersTekst"
                                   Text="Nog niemand ingeschreven. Wees de eerste!"
                                   Foreground="#888888" FontSize="14"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
