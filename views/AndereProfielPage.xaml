<Page x:Class="MoreConnector.Views.AndereProfielPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Profiel">
    <Page.Resources>
        <SolidColorBrush x:Key="OrangeBrush"    Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush"      Color="#1B2A3B"/>
        <SolidColorBrush x:Key="CardBrush"      Color="#1E2E40"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="Gray"/>
        <SolidColorBrush x:Key="WhiteBrush"     Color="White"/>
        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CC5200"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- SIDEBAR -->
        <Grid x:Name="SidebarGrid" Grid.Column="0" Background="{StaticResource OrangeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="More&#10;Connector" Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="12,20,12,12" LineHeight="20"/>
            <StackPanel Grid.Row="1" Margin="6,0,6,0">
                <Button x:Name="BtnHome"         Content="🏠  Home"         Style="{StaticResource SideNavBtn}" Click="SideNav_Home"/>
                <Button x:Name="BtnActiviteiten" Content="🎉  Activiteiten" Style="{StaticResource SideNavBtn}" Click="SideNav_Activiteiten"/>
                <Button x:Name="BtnBerichten"    Content="💬  Berichten"    Style="{StaticResource SideNavBtn}" Click="SideNav_Berichten"/>
                <Button x:Name="BtnGebruikers"   Content="👥  Gebruikers"   Style="{StaticResource SideNavBtn}" Click="SideNav_Gebruikers"/>
                <Button x:Name="BtnNotificaties" Content="🔔  Notificaties" Style="{StaticResource SideNavBtn}" Click="SideNav_Notificaties"/>
                <Button x:Name="BtnAanmaken"     Content="✏️  Aanmaken"     Style="{StaticResource SideNavBtn}" Click="SideNav_Aanmaken"/>
                <Button x:Name="BtnAdmin"        Content="🛡️  Beheer"       Style="{StaticResource SideNavBtn}" Click="SideNav_Admin" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="6,0,6,12">
                <Button x:Name="BtnProfiel" Style="{StaticResource SideNavBtn}" Click="SideNav_Profiel" Padding="8,8">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="32" Height="32" Margin="0,0,8,0">
                            <Ellipse x:Name="SideAvatarBg" Width="32" Height="32" Fill="#AAAAAA"/>
                            <Image x:Name="SideAvatarImg" Width="32" Height="32" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/></Image.Clip>
                            </Image>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SideNaamLabel" Text="Profiel" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SideRolLabel"  Text=""         Foreground="#FFDDBB" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnUitloggen" Content="🚪  Uitloggen" Style="{StaticResource SideNavBtn}" Click="SideNav_Uitloggen" Foreground="#FFDDBB"/>
            </StackPanel>
        </Grid>
        <!-- MAIN -->
        <ScrollViewer Grid.Column="1" Background="{StaticResource NavyBrush}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,28,32,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Terug -->
                <Button Grid.Row="0" Content="← Terug" HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource OrangeBrush}" FontSize="14"
                        Cursor="Hand" Margin="0,0,0,20" Click="OnTerugClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Profiel kaart -->
                <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="32" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Avatar -->
                        <Grid Grid.Column="0" Width="100" Height="100" Margin="0,0,24,0" VerticalAlignment="Top">
                            <Ellipse x:Name="ProfielAvatarBg" Width="100" Height="100" Fill="{StaticResource OrangeBrush}"/>
                            <Image x:Name="ProfielAvatarImg" Width="100" Height="100" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip><EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/></Image.Clip>
                            </Image>
                            <TextBlock x:Name="ProfielInitiaal" Foreground="White" FontSize="36" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock x:Name="NaamTekst" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="UsernameTekst" Foreground="{StaticResource OrangeBrush}" FontSize="15" Margin="0,0,0,4"/>
                            <TextBlock x:Name="StudieTekst" Foreground="#8899AA" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock x:Name="BioTekst" Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <!-- Tags -->
                            <WrapPanel x:Name="TagsPanel"/>
                        </StackPanel>
                        <!-- Vriendknop -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="16,0,0,0">
                            <Button x:Name="VriendenBtn" Content="➕  Bevriend"
                                    Background="{StaticResource OrangeBrush}" Foreground="White"
                                    BorderThickness="0" Padding="16,10" FontSize="13" FontWeight="SemiBold"
                                    Cursor="Hand" Click="OnVriendenBtnClick" Margin="0,0,0,8">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CC5200"/></Trigger>
                                            <Trigger Property="IsEnabled"   Value="False"><Setter Property="Background" Value="#555555"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BerichtBtn" Content="💬  Bericht sturen"
                                    Background="#1B3A55" Foreground="White"
                                    BorderThickness="0" Padding="16,10" FontSize="13" FontWeight="SemiBold"
                                    Cursor="Hand" Click="OnBerichtSturen">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0F2A40"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Posts van deze gebruiker -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Posts" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <StackPanel x:Name="PostsPanel"/>

                    <!-- Activiteiten -->
                    <TextBlock Text="Activiteiten"
                               Foreground="White" FontSize="15" FontWeight="SemiBold"
                               Margin="0,20,0,12"/>
                    <StackPanel x:Name="ActiviteitenPanel"/>

                    <!-- Connecties -->
                    <TextBlock Text="Connecties"
                               Foreground="White" FontSize="15" FontWeight="SemiBold"
                               Margin="0,20,0,12"/>
                    <StackPanel x:Name="ConnectiesPanel"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
