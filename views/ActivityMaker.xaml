<Page x:Class="MoreConnector.Views.ActivityMaker"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Evenement aanmaken">

    <Page.Resources>
        <SolidColorBrush x:Key="OrangeBrush"    Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush"      Color="#1B2A3B"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="Gray"/>
        <SolidColorBrush x:Key="WhiteBrush"     Color="White"/>



        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="{StaticResource LightGrayBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="12,10"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="Foreground"               Value="#333333"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="CaretBrush"               Value="#333333"/>
            <Setter Property="Cursor"                   Value="IBeam"/>
        </Style>
        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontSize"                   Value="14"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="14,10"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Margin"                     Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC5200"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#993D00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid x:Name="SidebarGrid" Grid.Column="0" Background="#FF8C00">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <TextBlock Grid.Row="0"
                       Text="More&#10;Connector"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       TextAlignment="Center" Margin="12,20,12,12" LineHeight="20"/>

            <!-- Nav knoppen -->
            <StackPanel Grid.Row="1" Margin="6,0,6,0">
                <Button x:Name="BtnHome"         Content="🏠  Home"         Style="{StaticResource SideNavBtn}" Click="SideNav_Home"/>
                <Button x:Name="BtnActiviteiten" Content="🎉  Activiteiten" Style="{StaticResource SideNavBtn}" Click="SideNav_Activiteiten"/>
                <Button x:Name="BtnBerichten"    Content="💬  Berichten"    Style="{StaticResource SideNavBtn}" Click="SideNav_Berichten"/>
                <Button x:Name="BtnGebruikers"   Content="👥  Gebruikers"   Style="{StaticResource SideNavBtn}" Click="SideNav_Gebruikers"/>
                <Button x:Name="BtnNotificaties" Content="🔔  Notificaties" Style="{StaticResource SideNavBtn}" Click="SideNav_Notificaties"/>
                <Button x:Name="BtnAanmaken"     Content="✏️  Aanmaken"     Style="{StaticResource SideNavBtn}" Click="SideNav_Aanmaken"/>
                <Button x:Name="BtnAdmin"        Content="🛡️  Beheer"       Style="{StaticResource SideNavBtn}" Click="SideNav_Admin"
                        Visibility="Collapsed"/>
            </StackPanel>

            <!-- Profiel + uitloggen -->
            <StackPanel Grid.Row="2" Margin="6,0,6,12">
                <Button x:Name="BtnProfiel" Style="{StaticResource SideNavBtn}" Click="SideNav_Profiel" Padding="8,8">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="32" Height="32" Margin="0,0,8,0">
                            <Ellipse x:Name="SideAvatarBg" Width="32" Height="32" Fill="#AAAAAA"/>
                            <Image x:Name="SideAvatarImg" Width="32" Height="32" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/></Image.Clip>
                            </Image>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SideNaamLabel" Text=""
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SideRolLabel" Text=""
                                       Foreground="#FFDDBB" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnUitloggen" Content="🚪  Uitloggen"
                        Style="{StaticResource SideNavBtn}" Click="SideNav_Uitloggen"
                        Foreground="#FFDDBB"/>
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Column="1" Background="{StaticResource NavyBrush}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="48,32,48,32">
            <StackPanel>

                <TextBlock Text="Nieuw evenement aanmaken"
                           Foreground="{StaticResource WhiteBrush}"
                           FontSize="22" FontWeight="Bold"
                           Margin="0,0,0,32"/>

                <!-- Naam + Categorie -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Naam" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="NaamInput" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Categorie" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="CategorieInput" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Datum & Locatie -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Datum" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="DatumPicker" Margin="0,0,0,8" FontSize="13"
                                    SelectedDateFormat="Short" FirstDayOfWeek="Monday"/>
                        <TextBlock Text="Tijdstip (HH:mm)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="DatumTijdInput" Style="{StaticResource InputStyle}"
                                 Text="12:00" ToolTip="Vul tijd in als HH:mm (bijv. 14:30)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Locatie" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="LocatieInput" Style="{StaticResource InputStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Max. deelnemers (0 = onbeperkt)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="MaxDeelnemersInput" Style="{StaticResource InputStyle}" Text="0"/>
                    </StackPanel>
                </Grid>

                <!-- Beschrijving -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Beschrijving" Style="{StaticResource LabelStyle}" Margin="0"/>
                    <TextBlock x:Name="BeschrijvingTeller" Grid.Column="1"
                               Text="0 / 300"
                               Foreground="#AAAAAA" FontSize="12"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBox x:Name="BeschrijvingInput"
                         Style="{StaticResource InputStyle}"
                         Height="100" MaxLength="300"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,4"
                         TextChanged="OnBeschrijvingChanged"/>
                <TextBlock Text="Max. 300 tekens."
                           Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,20"/>

                <!-- Afbeelding: aanbevolen grootte -->
                <TextBlock Text="Afbeelding  ·  Aanbevolen: 1920 × 1080 px  (max. 5 MB)"
                           Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button x:Name="AfbeeldingButton"
                            Content="+ Kies afbeelding"
                            Background="#7B4F00" Foreground="{StaticResource WhiteBrush}"
                            FontSize="13" BorderThickness="0" Padding="16,8" Cursor="Hand"
                            Click="OnAfbeeldingClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5C3A00"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border x:Name="AfbeeldingPreviewBorder"
                            CornerRadius="8" Margin="12,0,0,0"
                            Background="#1E2E40" Width="80" Height="60"
                            Visibility="Collapsed">
                        <Image x:Name="AfbeeldingPreview" Stretch="UniformToFill"/>
                    </Border>
                </StackPanel>

                <!-- Tags -->
                <TextBlock Text="Tags" Style="{StaticResource LabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="#1E2E40" CornerRadius="8" Padding="2">
                        <TextBox x:Name="TagInput"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource WhiteBrush}"
                                 FontSize="13" Padding="10,6" MinWidth="160"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Content="+ Voeg toe"
                            Background="{StaticResource OrangeBrush}" Foreground="{StaticResource WhiteBrush}"
                            FontSize="13" BorderThickness="0" Padding="12,6" Margin="8,0,0,0" Cursor="Hand"
                            Click="OnTagToevoegen">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <WrapPanel x:Name="TagsPanel" Margin="0,0,0,24"/>

                <!-- Aanmaken + Annuleren -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Evenement aanmaken"
                            Background="{StaticResource OrangeBrush}" Foreground="{StaticResource WhiteBrush}"
                            FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                            Padding="24,10" Cursor="Hand" Margin="0,0,12,0"
                            Click="OnAanmakenBevestigenClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CC5200"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Annuleren"
                            Background="{StaticResource LightGrayBrush}" Foreground="#333333"
                            FontSize="14" BorderThickness="0" Padding="24,10" Cursor="Hand"
                            Click="OnAnnulerenClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
