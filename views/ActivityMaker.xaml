<Page x:Class="MoreConnector.Views.ActivityMaker"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1120" d:DesignHeight="650"
      Title="Activiteit aanmaken">

    <Page.Resources>
        <SolidColorBrush x:Key="OrangeBrush"    Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush"      Color="#1B2A3B"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="Gray"/>
        <SolidColorBrush x:Key="WhiteBrush"     Color="White"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize"                   Value="16"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="16,10"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC5200"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#993D00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallAvatarStyle" TargetType="Ellipse">
            <Setter Property="Width"  Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Fill"   Value="{StaticResource LightGrayBrush}"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource LightGrayBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Foreground"      Value="#333333"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="{StaticResource OrangeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,24,0,0">
                <Button Content="Home"         Style="{StaticResource NavButtonStyle}" Click="OnHomeClick"/>
                <Button Content="Activiteiten" Style="{StaticResource NavButtonStyle}" Click="OnActiviteitenClick"/>
                <Button Content="Berichten"    Style="{StaticResource NavButtonStyle}" Click="OnBerichtenClick"/>
                <Button Content="Aanmaken"     Style="{StaticResource NavButtonStyle}" Click="OnAanmakenClick"/>
            </StackPanel>

            <Button Grid.Row="1" Style="{StaticResource NavButtonStyle}" Margin="8,0,8,16" Click="OnProfielClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource SmallAvatarStyle}" Margin="0,0,10,0"/>
                    <TextBlock Text="Profiel" Foreground="{StaticResource WhiteBrush}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Column="1" Background="{StaticResource NavyBrush}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="48,32,48,32">
            <StackPanel>

                <!-- Titel -->
                <TextBlock Text="Nieuwe activiteit aanmaken"
                           Foreground="{StaticResource WhiteBrush}"
                           FontSize="22" FontWeight="Bold"
                           Margin="0,0,0,32"/>

                <!-- Naam + Categorie -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Naam" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="NaamInput" Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Categorie" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="CategorieInput" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Datum & Tijd + Locatie -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Datum &amp; Tijd" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="DatumTijdInput" Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Locatie" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="LocatieInput" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Beschrijving -->
                <TextBlock Text="Beschrijving" Style="{StaticResource LabelStyle}" Margin="200,0,0,6"/>
                <TextBox x:Name="BeschrijvingInput"
                         Style="{StaticResource InputStyle}"
                         Height="120"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="200,0,200,20"/>

                <!-- Afbeelding toevoegen -->
                <Button x:Name="AfbeeldingButton"
                        Content="Voeg een afbeelding toe+"
                        Background="#7B4F00"
                        Foreground="{StaticResource WhiteBrush}"
                        FontSize="14"
                        BorderThickness="0"
                        Padding="0,14"
                        Cursor="Hand"
                        Margin="0,0,0,32"
                        Click="OnAfbeeldingClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5C3A00"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Aanmaken + Annuleren -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button x:Name="AanmakenButton"
                            Content="Aanmaken"
                            Background="{StaticResource OrangeBrush}"
                            Foreground="{StaticResource WhiteBrush}"
                            FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="24,10"
                            Cursor="Hand"
                            Margin="0,0,12,0"
                            Click="OnAanmakenBevestigenClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CC5200"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="AnnulerenButton"
                            Content="Annuleren"
                            Background="{StaticResource LightGrayBrush}"
                            Foreground="#333333"
                            FontSize="14"
                            BorderThickness="0"
                            Padding="24,10"
                            Cursor="Hand"
                            Click="OnAnnulerenClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#BBBBBB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>