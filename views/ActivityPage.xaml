<Page x:Class="MoreConnector.Views.ActivityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1120" d:DesignHeight="650"
      Title="Activiteiten">

    <Page.Resources>
        <SolidColorBrush x:Key="OrangeBrush"    Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush"      Color="#1B2A3B"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="Gray"/>
        <SolidColorBrush x:Key="WhiteBrush"     Color="White"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize"                   Value="16"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="16,10"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC5200"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#993D00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AvatarStyle" TargetType="Ellipse">
            <Setter Property="Width"  Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Fill"   Value="{StaticResource LightGrayBrush}"/>
        </Style>

        <Style x:Key="SmallAvatarStyle" TargetType="Ellipse" BasedOn="{StaticResource AvatarStyle}">
            <Setter Property="Width"  Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="{StaticResource OrangeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,24,0,0">
                <Button Content="Home"         Style="{StaticResource NavButtonStyle}" Click="OnHomeClick"/>
                <Button Content="Activiteiten" Style="{StaticResource NavButtonStyle}" Click="OnActiviteitenClick"/>
                <Button Content="Berichten"    Style="{StaticResource NavButtonStyle}" Click="OnBerichtenClick"/>
                <Button Content="Aanmaken"     Style="{StaticResource NavButtonStyle}" Click="OnAanmakenClick"/>
            </StackPanel>

            <Button Grid.Row="1" Style="{StaticResource NavButtonStyle}" Margin="8,0,8,16" Click="OnProfielClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource SmallAvatarStyle}" Margin="0,0,10,0"/>
                    <TextBlock Text="Profiel" Foreground="{StaticResource WhiteBrush}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource NavyBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Margin="32,28,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Goedemiddag, "
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="UsernameText"
                               Text="Jente"
                               Foreground="{StaticResource OrangeBrush}"
                               FontSize="28" FontWeight="Bold"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource WhiteBrush}"
                        CornerRadius="20" Padding="14,6" Margin="0,0,16,0">
                    <TextBox x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             FontSize="14" VerticalContentAlignment="Center"
                             MinWidth="200"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"/>
                </Border>

                <Ellipse Grid.Column="2" Style="{StaticResource AvatarStyle}" VerticalAlignment="Center"/>
            </Grid>

            <!-- ACTIVITEITEN -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="32,24,32,24">
                <StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Aanbevolen Activiteiten"
                                   Foreground="{StaticResource WhiteBrush}"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="BekijkAllesButton"
                                Content="bekijk alles →"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource OrangeBrush}"
                                FontSize="14" Cursor="Hand"
                                Click="OnBekijkAllesClick"/>
                    </Grid>

                    <ItemsControl x:Name="PostPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource LightGrayBrush}"
                                        CornerRadius="12" Margin="8" MinHeight="160">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Content="verwijderen"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,8,8,0"
                                                Padding="8,4"
                                                FontSize="11"
                                                Background="{StaticResource LightGrayBrush}"
                                                BorderBrush="#999999"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Visibility="{Binding CanDeleteVisibility}"
                                                Tag="{Binding}"
                                                Click="OnVerwijderClick"/>

                                        <TextBlock Grid.Row="0"
                                                   Text="afbeelding activiteit"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#888888"
                                                   FontSize="13"/>

                                        <Border Grid.Row="1"
                                                Background="{StaticResource OrangeBrush}"
                                                CornerRadius="0,0,12,12"
                                                Padding="10,8"
                                                Visibility="{Binding InfoVisibility}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titel}"
                                                           Foreground="{StaticResource WhiteBrush}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Locatie}"
                                                           Foreground="{StaticResource WhiteBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>