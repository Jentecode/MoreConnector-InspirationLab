<Page x:Class="MoreConnector.Views.Feed"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1120" d:DesignHeight="650"
      Title="Activiteiten">

    <Page.Resources>
        <SolidColorBrush x:Key="OrangeBrush"    Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush"      Color="#1B2A3B"/>
        <SolidColorBrush x:Key="CardBrush"      Color="#1E2E40"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="Gray"/>
        <SolidColorBrush x:Key="WhiteBrush"     Color="White"/>



        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontSize"                   Value="14"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="14,10"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Margin"                     Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bdr" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC5200"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#993D00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid x:Name="SidebarGrid" Grid.Column="0" Background="#FF8C00">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <TextBlock Grid.Row="0"
                       Text="More&#10;Connector"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       TextAlignment="Center" Margin="12,20,12,12" LineHeight="20"/>

            <!-- Nav knoppen -->
            <StackPanel Grid.Row="1" Margin="6,0,6,0">
                <Button x:Name="BtnHome"         Content="🏠  Home"         Style="{StaticResource SideNavBtn}" Click="SideNav_Home"/>
                <Button x:Name="BtnActiviteiten" Content="🎉  Activiteiten" Style="{StaticResource SideNavBtn}" Click="SideNav_Activiteiten"/>
                <Button x:Name="BtnBerichten"    Content="💬  Berichten"    Style="{StaticResource SideNavBtn}" Click="SideNav_Berichten"/>
                <Button x:Name="BtnGebruikers"   Content="👥  Gebruikers"   Style="{StaticResource SideNavBtn}" Click="SideNav_Gebruikers"/>
                <Button x:Name="BtnNotificaties" Content="🔔  Notificaties" Style="{StaticResource SideNavBtn}" Click="SideNav_Notificaties"/>
                <Button x:Name="BtnAanmaken"     Content="✏️  Aanmaken"     Style="{StaticResource SideNavBtn}" Click="SideNav_Aanmaken"/>
                <Button x:Name="BtnAdmin"        Content="🛡️  Beheer"       Style="{StaticResource SideNavBtn}" Click="SideNav_Admin"
                        Visibility="Collapsed"/>
            </StackPanel>

            <!-- Profiel + uitloggen -->
            <StackPanel Grid.Row="2" Margin="6,0,6,12">
                <Button x:Name="BtnProfiel" Style="{StaticResource SideNavBtn}" Click="SideNav_Profiel" Padding="8,8">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="32" Height="32" Margin="0,0,8,0">
                            <Ellipse x:Name="SideAvatarBg" Width="32" Height="32" Fill="#AAAAAA"/>
                            <Image x:Name="SideAvatarImg" Width="32" Height="32" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/></Image.Clip>
                            </Image>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SideNaamLabel" Text="Profiel"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SideRolLabel" Text=""
                                       Foreground="#FFDDBB" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnUitloggen" Content="🚪  Uitloggen"
                        Style="{StaticResource SideNavBtn}" Click="SideNav_Uitloggen"
                        Foreground="#FFDDBB"/>
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource NavyBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Margin="32,28,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Goedemiddag, "
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="UsernameText"
                               Text="Jente"
                               Foreground="{StaticResource OrangeBrush}"
                               FontSize="28" FontWeight="Bold"/>
                </StackPanel>


                <Button x:Name="TopbarAvatarBtn" Grid.Column="1" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnProfielAvatarClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="48" Height="48" VerticalAlignment="Center">
                                <Ellipse x:Name="TopbarAvatarBg" Width="48" Height="48" Fill="{StaticResource LightGrayBrush}"/>
                                <Image x:Name="TopbarAvatarImg" Width="48" Height="48" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip><EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/></Image.Clip>
                                </Image>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- SCROLLVIEWER MET BEIDE SECTIES -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="32,0,32,24">
                <StackPanel>

                    <!-- SECTIE 1: Activiteiten grid -->
                    <TextBlock Text="Recente posts"
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="16" FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <ItemsControl x:Name="PostPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="12" Margin="8" MinHeight="160">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="afbeelding activiteit"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#888888"
                                                   FontSize="13"/>

                                        <Border Grid.Row="1"
                                                Background="{StaticResource OrangeBrush}"
                                                CornerRadius="0,0,12,12"
                                                Padding="10,8"
                                                Visibility="{Binding InfoVisibility}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titel}"
                                                           Foreground="{StaticResource WhiteBrush}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Locatie}"
                                                           Foreground="{StaticResource WhiteBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- SECTIE 2: Sociale feed -->
                    <StackPanel x:Name="FeedPanel"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
