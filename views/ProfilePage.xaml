<Page x:Class="MoreConnector.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1120" d:DesignHeight="650"
      Title="Profiel">

    <Page.Resources>
        <SolidColorBrush x:Key="OrangeBrush"    Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush"      Color="#1B2A3B"/>
        <SolidColorBrush x:Key="CardBrush"      Color="#1E2E40"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="Gray"/>
        <SolidColorBrush x:Key="WhiteBrush"     Color="White"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize"                   Value="16"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="16,10"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC5200"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#993D00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AvatarStyle" TargetType="Ellipse">
            <Setter Property="Width"  Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Fill"   Value="{StaticResource LightGrayBrush}"/>
        </Style>

        <Style x:Key="SmallAvatarStyle" TargetType="Ellipse" BasedOn="{StaticResource AvatarStyle}">
            <Setter Property="Width"  Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="TagStyle" TargetType="Border">
            <Setter Property="Background"    Value="#CC5200"/>
            <Setter Property="CornerRadius"  Value="12"/>
            <Setter Property="Padding"       Value="14,6"/>
            <Setter Property="Margin"        Value="0,0,8,8"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="{StaticResource OrangeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,24,0,0">
                <Button Content="Home"         Style="{StaticResource NavButtonStyle}" Click="OnHomeClick"/>
                <Button Content="Activiteiten" Style="{StaticResource NavButtonStyle}" Click="OnActiviteitenClick"/>
                <Button Content="Berichten"    Style="{StaticResource NavButtonStyle}" Click="OnBerichtenClick"/>
                <Button Content="Aanmaken"     Style="{StaticResource NavButtonStyle}" Click="OnAanmakenClick"/>
            </StackPanel>

            <Button Grid.Row="1" Style="{StaticResource NavButtonStyle}" Margin="8,0,8,16" Click="OnProfielClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource SmallAvatarStyle}" Margin="0,0,10,0"/>
                    <TextBlock Text="Profiel" Foreground="{StaticResource WhiteBrush}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource NavyBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LINKER PANEEL: avatar, naam, richting, knop, interesses -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                    Margin="0" Padding="24,32,24,24">
                <StackPanel>

                    <!-- Profielfoto -->
                    <Ellipse Width="100" Height="100"
                             Fill="{StaticResource LightGrayBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,16"/>

                    <!-- Naam -->
                    <TextBlock x:Name="GebruikersnaamText"
                               Text="SocialGuy900"
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <!-- Richting -->
                    <TextBlock x:Name="RichtingText"
                               Text="Applied Data Intelligence"
                               Foreground="{StaticResource LightGrayBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Profiel bewerken knop -->
                    <Button x:Name="ProfielBewerkenButton"
                            Content="Profiel bewerken"
                            Background="{StaticResource OrangeBrush}"
                            Foreground="{StaticResource WhiteBrush}"
                            FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="16,10"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,32"
                            Click="OnProfielBewerkenClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="20"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CC5200"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Interesses -->
                    <TextBlock Text="Interesses"
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <WrapPanel x:Name="InteressesPanel" Orientation="Horizontal"/>

                </StackPanel>
            </Border>

            <!-- RECHTER PANEEL: activiteiten + connecties -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,28,28,28">
                <StackPanel>

                    <!-- Mijn activiteiten -->
                    <TextBlock Text="Mijn activiteiten"
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <ItemsControl x:Name="MijnActiviteitenPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource LightGrayBrush}"
                                        CornerRadius="12" Margin="0,0,12,12" MinHeight="130">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="1"
                                                Background="{StaticResource OrangeBrush}"
                                                CornerRadius="0,0,12,12"
                                                Padding="10,8"
                                                Visibility="{Binding InfoVisibility}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titel}"
                                                           Foreground="{StaticResource WhiteBrush}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Locatie}"
                                                           Foreground="{StaticResource WhiteBrush}"
                                                           FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Mijn connecties -->
                    <TextBlock Text="Mijn connecties"
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,16,0,12"/>

                    <ItemsControl x:Name="ConnectiesPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Style="{StaticResource SmallAvatarStyle}" Margin="0,0,12,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Naam}"
                                                   Foreground="{StaticResource WhiteBrush}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="2"
                                                Background="{StaticResource OrangeBrush}"
                                                CornerRadius="8" Padding="14,4">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{StaticResource WhiteBrush}"
                                                       FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>