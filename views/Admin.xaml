<Page x:Class="MoreConnector.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1120" d:DesignHeight="650"
      Title="Beheer">

    <Page.Resources>

        <SolidColorBrush x:Key="OrangeBrush" Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush" Color="#1B2A3B"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E2E40"/>
        <SolidColorBrush x:Key="RedBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="DarkRedBrush" Color="#922B21"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#D35400"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="Gray"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8899AA"/>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TabButtonActiveStyle"
               BasedOn="{StaticResource TabButtonStyle}"
               TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OrangeBrush}"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="WarnButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource NavyBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="32,28,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️  Beheer — " Foreground="White" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Adminpanel" Foreground="{StaticResource OrangeBrush}" FontSize="26" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🏠  Naar app"
                        Background="{StaticResource OrangeBrush}"
                        Foreground="White" BorderThickness="0"
                        Padding="14,8" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand" Margin="0,0,10,0"
                        Click="OnNaarAppClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CC5200"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="🚪  Uitloggen"
                        Background="#C0392B"
                        Foreground="White" BorderThickness="0"
                        Padding="14,8" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="OnUitloggenClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#922B21"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- TABS -->
        <Border Grid.Row="1" BorderBrush="#2A3F55" BorderThickness="0,0,0,1" Margin="32,0,32,0">
            <StackPanel Orientation="Horizontal">

                <Button x:Name="TabPostsBtn"
                        Content="📝 Posts"
                        Style="{StaticResource TabButtonActiveStyle}"
                        Click="OnTabPosts"/>

                <Button x:Name="TabEventsBtn"
                        Content="📅 Evenementen"
                        Style="{StaticResource TabButtonStyle}"
                        Click="OnTabEvents"/>

                <Button x:Name="TabUsersBtn"
                        Content="👤 Gebruikers"
                        Style="{StaticResource TabButtonStyle}"
                        Click="OnTabUsers"/>

                <Button x:Name="TabCommentsBtn"
                        Content="💬 Reacties"
                        Style="{StaticResource TabButtonStyle}"
                        Click="OnTabComments"/>

            </StackPanel>
        </Border>

        <!-- POSTS -->
        <ScrollViewer x:Name="PostsPanel"
                      Grid.Row="2"
                      Margin="32,24,32,24">

            <StackPanel>

                <TextBlock Text="Alle posts" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>

                <TextBox x:Name="PostsSearchBox"
                         Height="38"
                         Margin="0,0,0,16"
                         TextChanged="PostsSearchBox_TextChanged"/>

                <ItemsControl x:Name="PostsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Auteur}" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Beschrijving}" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding DatumTekst}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Verwijderen"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Tag="{Binding}"
                                            Click="OnPostVerwijderenClick"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="PostsLeegTekst"
                           Text="Geen posts gevonden."
                           Foreground="{StaticResource MutedBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- EVENTS -->
        <ScrollViewer x:Name="EventsPanel"
                      Grid.Row="2"
                      Margin="32,24,32,24"
                      Visibility="Collapsed">

            <StackPanel>

                <TextBlock Text="Alle evenementen" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>

                <TextBox x:Name="EventsSearchBox"
                         Height="38"
                         Margin="0,0,0,16"
                         TextChanged="EventsSearchBox_TextChanged"/>

                <ItemsControl x:Name="EventsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Naam}" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Locatie}" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding DatumTekst}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Verwijderen"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Tag="{Binding}"
                                            Click="OnEventVerwijderenClick"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EventsLeegTekst"
                           Text="Geen evenementen gevonden."
                           Foreground="{StaticResource MutedBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- USERS -->
        <ScrollViewer x:Name="UsersPanel"
                      Grid.Row="2"
                      Margin="32,24,32,24"
                      Visibility="Collapsed">

            <StackPanel>

                <TextBlock Text="Alle gebruikers" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>

                <TextBox x:Name="UsersSearchBox"
                         Height="38"
                         Margin="0,0,0,16"
                         TextChanged="UsersSearchBox_TextChanged"/>

                <ItemsControl x:Name="UsersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding VolledigeNaam}" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DisplayNaam}"   Foreground="{StaticResource OrangeBrush}" FontSize="12"/>
                                        <!-- Email enkel zichtbaar voor admin -->
                                        <TextBlock Text="{Binding Email}" Foreground="{StaticResource MutedBrush}" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Ban/Unban toggle via DataTrigger op IsActive -->
                                        <Button Tag="{Binding}"
                                                Click="OnBanToggleClick"
                                                Margin="0,0,6,0"
                                                Padding="8,4" BorderThickness="0"
                                                Foreground="White" Cursor="Hand" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content"     Value="Verban"/>
                                                    <Setter Property="Background"  Value="#883333"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Content"    Value="Deblokkeer"/>
                                                            <Setter Property="Background" Value="#338833"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="✉ Email"
                                                Background="#336699" Foreground="White"
                                                BorderThickness="0" Padding="8,4"
                                                Cursor="Hand" FontSize="11"
                                                Tag="{Binding}"
                                                Click="OnEmailWijzigenClick"
                                                Margin="0,0,6,0"/>
                                        <Button Content="🔑 Wachtwoord"
                                                Background="#555566" Foreground="White"
                                                BorderThickness="0" Padding="8,4"
                                                Cursor="Hand" FontSize="11"
                                                Tag="{Binding}"
                                                Click="OnWachtwoordWijzigenClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="UsersLeegTekst"
                           Text="Geen gebruikers gevonden."
                           Foreground="{StaticResource MutedBrush}"
                           Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <!-- COMMENTS -->
        <ScrollViewer x:Name="CommentsPanel"
                      Grid.Row="2"
                      Margin="32,24,32,24"
                      Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Alle reacties" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                <TextBox x:Name="CommentsSearchBox"
                         Height="38"
                         Margin="0,0,0,16"
                         TextChanged="CommentsSearchBox_TextChanged"/>
                <ItemsControl x:Name="CommentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding AuthorName}" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Content}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CreatedAtTekst}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Verwijderen"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Tag="{Binding}"
                                            Click="OnCommentVerwijderenClick"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="CommentsLeegTekst"
                           Text="Geen reacties gevonden."
                           Foreground="{StaticResource MutedBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>