<Page x:Class="MoreConnector.Views.PasswordReset"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" Title="Wachtwoord resetten">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Rectangle Grid.Row="0" Fill="#FF8C00"/>
        <Rectangle Grid.Row="1" Fill="White"/>

        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="White" CornerRadius="16" Padding="40"
                Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <Button Content="← Terug naar inloggen"
                        Background="Transparent" Foreground="#FF8C00"
                        BorderThickness="0" FontSize="13"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Margin="0,0,0,16" Click="BtnTerug_Click"/>

                <TextBlock Text="Wachtwoord resetten"
                           FontSize="26" FontWeight="Bold" Foreground="#111"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="SubTekst"
                           Text="Voer je e-mailadres in om een resetcode te ontvangen."
                           FontSize="13" Foreground="#555" TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                <!-- STAP 1: E-mail -->
                <StackPanel x:Name="StapEmail">
                    <TextBlock Text="E-mailadres" FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                    <Border BorderBrush="#4A90D9" BorderThickness="1.5" CornerRadius="6" Margin="0,0,0,16">
                        <TextBox x:Name="TxtEmail" BorderThickness="0" Padding="10,8"
                                 FontSize="13" Background="Transparent"/>
                    </Border>
                    <Button x:Name="BtnStuurCode" Content="Stuur resetcode"
                            Background="#1B2A3B" Foreground="White"
                            FontSize="14" FontWeight="Bold" Height="46"
                            Cursor="Hand" BorderThickness="0" Click="BtnStuurCode_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- STAP 2: Code invoeren -->
                <StackPanel x:Name="StapCode" Visibility="Collapsed">
                    <TextBlock Text="Resetcode (6 cijfers)" FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                    <Border BorderBrush="#4A90D9" BorderThickness="1.5" CornerRadius="6" Margin="0,0,0,16">
                        <TextBox x:Name="TxtCode" BorderThickness="0" Padding="10,8"
                                 FontSize="18" TextAlignment="Center" Background="Transparent"
                                 MaxLength="6"/>
                    </Border>
                    <Button Content="Code bevestigen"
                            Background="#1B2A3B" Foreground="White"
                            FontSize="14" FontWeight="Bold" Height="46"
                            Cursor="Hand" BorderThickness="0" Click="BtnBevestigCode_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- STAP 3: Nieuw wachtwoord -->
                <StackPanel x:Name="StapNieuwWachtwoord" Visibility="Collapsed">
                    <TextBlock Text="Nieuw wachtwoord" FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                    <Border BorderBrush="#4A90D9" BorderThickness="1.5" CornerRadius="6" Margin="0,0,0,12">
                        <PasswordBox x:Name="TxtNieuw" BorderThickness="0" Padding="10,8"
                                     FontSize="13" Background="Transparent"/>
                    </Border>
                    <TextBlock Text="Bevestig wachtwoord" FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                    <Border BorderBrush="#4A90D9" BorderThickness="1.5" CornerRadius="6" Margin="0,0,0,16">
                        <PasswordBox x:Name="TxtBevestig" BorderThickness="0" Padding="10,8"
                                     FontSize="13" Background="Transparent"/>
                    </Border>
                    <Button Content="Wachtwoord opslaan"
                            Background="#FF8C00" Foreground="White"
                            FontSize="14" FontWeight="Bold" Height="46"
                            Cursor="Hand" BorderThickness="0" Click="BtnOpslaanWachtwoord_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="FoutTekst" Foreground="Red" FontSize="12"
                           Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
