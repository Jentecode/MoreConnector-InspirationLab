<Page x:Class="MoreConnector.PasswordReset"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Password reset · Primary">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Rectangle Grid.Row="0" Fill="#FF8C00"/>
        <Rectangle Grid.Row="1" Fill="White"/>
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="White"
                CornerRadius="16"
                Padding="40"
                Width="500"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <!-- Terugknop -->
                <Button x:Name="BtnTerug"
                        Content="← Terug naar inloggen"
                        Background="Transparent"
                        Foreground="#FF8C00"
                        BorderThickness="0"
                        FontSize="13"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Margin="0,0,0,12"
                        Click="BtnTerug_Click"/>

                <TextBlock Text="Welcome bij MoreConnector"
                           FontSize="13"
                           Foreground="#333333"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Wachtwoord resetten"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#111111"
                           Margin="0,0,0,40"/>
                <TextBlock Text="Voer je gebruikersnaam of email-adres in"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,0,6"/>
                <Border BorderBrush="#4A90D9"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Margin="0,0,0,40">
                    <TextBox x:Name="TxtEmail"
                             Text="gebruikersnaam of email-adres"
                             Foreground="Gray"
                             BorderThickness="0"
                             Padding="10,8"
                             FontSize="13"
                             Background="Transparent"
                             GotFocus="TxtEmail_GotFocus"
                             LostFocus="TxtEmail_LostFocus"/>
                </Border>
                <Button x:Name="BtnSend"
                        Content="mail versturen"
                        Background="#1B2A3B"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Height="48"
                        Cursor="Hand"
                        BorderThickness="0"
                        Click="BtnSend_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>