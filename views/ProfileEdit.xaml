<Page x:Class="MoreConnector.Views.ProfileEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1120" d:DesignHeight="650"
      Title="Profielinstellingen">

    <Page.Resources>
        <SolidColorBrush x:Key="OrangeBrush"    Color="#FF8C00"/>
        <SolidColorBrush x:Key="NavyBrush"      Color="#1B2A3B"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="WhiteBrush"     Color="White"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize"                   Value="16"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="16,10"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC5200"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#993D00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AvatarStyle" TargetType="Ellipse">
            <Setter Property="Width"  Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Fill"   Value="{StaticResource LightGrayBrush}"/>
        </Style>

        <Style x:Key="SmallAvatarStyle" TargetType="Ellipse" BasedOn="{StaticResource AvatarStyle}">
            <Setter Property="Width"  Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- FIXED: White background so text is visible and fields are editable -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#AAAAAA"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Foreground"      Value="#333333"/>
            <Setter Property="IsReadOnly"      Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF8C00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrangeButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource OrangeBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC5200"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#8B1A1A"/>
            <Setter Property="Foreground"      Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6B1010"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FIXED: Bio TextBox style (same as InputStyle but multiline) -->
        <Style x:Key="BioInputStyle" TargetType="TextBox">
            <Setter Property="Background"              Value="White"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="BorderBrush"             Value="#AAAAAA"/>
            <Setter Property="Padding"                 Value="10,8"/>
            <Setter Property="FontSize"                Value="14"/>
            <Setter Property="Foreground"              Value="#333333"/>
            <Setter Property="IsReadOnly"              Value="False"/>
            <Setter Property="TextWrapping"            Value="Wrap"/>
            <Setter Property="AcceptsReturn"           Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF8C00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="{StaticResource OrangeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,24,0,0">
                <Button Content="Home"         Style="{StaticResource NavButtonStyle}" Click="OnHomeClick"/>
                <Button Content="Activiteiten" Style="{StaticResource NavButtonStyle}" Click="OnActiviteitenClick"/>
                <Button Content="Berichten"    Style="{StaticResource NavButtonStyle}" Click="OnBerichtenClick"/>
                <Button Content="Aanmaken"     Style="{StaticResource NavButtonStyle}" Click="OnAanmakenClick"/>
            </StackPanel>

            <Button Grid.Row="1" Style="{StaticResource NavButtonStyle}" Margin="8,0,8,16" Click="OnProfielClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource SmallAvatarStyle}" Margin="0,0,10,0"/>
                    <TextBlock Text="Profiel" Foreground="{StaticResource WhiteBrush}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Column="1" Background="{StaticResource NavyBrush}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="32,28,32,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titel -->
                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0"
                           Text="Profiel bewerken"
                           Foreground="{StaticResource WhiteBrush}"
                           FontSize="22" FontWeight="Bold"
                           Margin="0,0,0,28"/>

                <!-- LINKER KOLOM: formuliervelden -->
                <StackPanel Grid.Column="0" Grid.Row="1">

                    <TextBlock Text="Voornaam" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="VoornaamInput"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Achternaam" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="AchternaamInput"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="EmailInput"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Telefoonnummer" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TelefoonnummerInput"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Studierichting" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="StudierichtingInput"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,24"/>

                    <Button Content="Opslaan"
                            Style="{StaticResource OrangeButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="OnOpslaanClick"/>

                </StackPanel>

                <!-- RECHTER KOLOM: foto + bio + account verwijderen -->
                <StackPanel Grid.Column="2" Grid.Row="1">

                    <TextBlock Text="Openbaar profiel"
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <!-- Profielfoto + knoppen -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0"
                                 Width="110" Height="110"
                                 Fill="{StaticResource LightGrayBrush}"
                                 Margin="0,0,20,0"
                                 VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Content="Wijzig foto"
                                    Style="{StaticResource OrangeButtonStyle}"
                                    Margin="0,0,0,10"
                                    Click="OnWijzigFotoClick"/>
                            <Button Content="Verwijder foto"
                                    Style="{StaticResource OrangeButtonStyle}"
                                    Click="OnVerwijderFotoClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bio -->
                    <TextBlock Text="Bio" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="BioInput"
                             Style="{StaticResource BioInputStyle}"
                             Height="160"
                             Margin="0,0,0,24"/>

                    <!-- Account verwijderen -->
                    <Button x:Name="AccountVerwijderenButton"
                            Content="Account verwijderen"
                            Style="{StaticResource DangerButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="OnAccountVerwijderenClick"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
