<Window x:Class="MoreConnector.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login pagina · Primary" Height="720" Width="1060"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Fill="#FF8C00"/>
        <Rectangle Grid.Row="1" Fill="White"/>

        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="White"
                CornerRadius="16"
                Padding="40"
                Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0,0,80,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="Black"/>
            </Border.Effect>

            <StackPanel>

                <!-- Header row -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Welcome bij MoreConnector"
                               FontSize="13"
                               Foreground="#333333"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Nog geen account?"
                                   FontSize="11"
                                   Foreground="#555555"/>
                        <TextBlock Text="klik hier"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#111111"
                                   Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Title -->
                <TextBlock Text="Inloggen"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#111111"
                           Margin="0,4,0,24"/>

                <!-- Username label -->
                <TextBlock Text="Voer je gebruikersnaam of email-adres in"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,0,6"/>

                <!-- Username field -->
                <Border BorderBrush="#4A90D9"
                        BorderThickness="2"
                        CornerRadius="6"
                        Margin="0,0,0,16">
                    <TextBox x:Name="TxtUsername"
                             Text="gebruikersnaam of email-adres"
                             Foreground="Gray"
                             BorderThickness="0"
                             Padding="10,8"
                             FontSize="13"
                             Background="Transparent"
                             GotFocus="TxtUsername_GotFocus"
                             LostFocus="TxtUsername_LostFocus"/>
                </Border>

                <!-- Password label -->
                <TextBlock Text="Wachtwoord"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,0,6"/>

                <!-- Password field -->
                <Border BorderBrush="#CCCCCC"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Margin="0,0,0,6">
                    <PasswordBox x:Name="TxtPassword"
                                 BorderThickness="0"
                                 Padding="10,8"
                                 FontSize="13"
                                 Background="Transparent"/>
                </Border>

                <!-- Forgot password -->
                <TextBlock Text="Wachtwoord vergeten?"
                           FontSize="11"
                           Foreground="#333333"
                           Cursor="Hand"
                           Margin="0,0,0,16"/>

                <!-- Phone label -->
                <TextBlock Text="Telefoonnummer"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,0,6"/>

                <!-- Phone field -->
                <Border BorderBrush="#CCCCCC"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Left"
                        Width="180">
                    <TextBox x:Name="TxtPhone"
                             Text="Telefoonnummer"
                             Foreground="Gray"
                             BorderThickness="0"
                             Padding="10,8"
                             FontSize="13"
                             Background="Transparent"
                             GotFocus="TxtPhone_GotFocus"
                             LostFocus="TxtPhone_LostFocus"/>
                </Border>

                <!-- Login button -->
                <Button x:Name="BtnLogin"
                        Content="Klik hier"
                        Background="#1B2A3B"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Height="44"
                        Cursor="Hand"
                        BorderThickness="0"
                        Click="BtnLogin_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>